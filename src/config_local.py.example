# WiFi Configuration
WIFI_SSID = "YourSSID"
WIFI_PASSWORD = "YourPassword"
# Optional AP lock (helps on mesh networks)
# WIFI_BSSID = "AA:BB:CC:DD:EE:FF"

# MQTT Configuration
MQTT_BROKER = "127.0.0.1"  # Loopback for the Geist host processes
MQTT_PORT = 1883
MQTT_USERNAME = ""
MQTT_PASSWORD = ""
